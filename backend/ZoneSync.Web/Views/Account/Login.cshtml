@model ZoneSync.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="mx-auto flex max-w-6xl flex-col overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white/80 shadow-soft backdrop-blur lg:flex-row">
    <div class="flex-1 bg-gradient-to-br from-brand-600 via-emerald-600 to-slate-900 p-8 text-white lg:p-10">
        <div class="flex h-full flex-col justify-between gap-8">
            <div class="space-y-4">
                <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-sm font-medium backdrop-blur">
                    <i data-lucide="shield-check" class="h-4 w-4"></i>
                    Secure access
                </div>
                <div>
                    <h1 class="text-3xl font-semibold tracking-tight">Welcome back to ZoneSync.</h1>
                    <p class="mt-3 max-w-md text-base text-emerald-50/90">Continue coordinating your farm operations with a polished, reliable workspace.</p>
                </div>
            </div>
            <div class="rounded-2xl border border-white/15 bg-slate-950/20 p-5 text-sm text-emerald-50/90">
                <p class="font-medium">Why teams use ZoneSync</p>
                <ul class="mt-3 space-y-2">
                    <li class="flex items-center gap-2"><i data-lucide="check" class="h-4 w-4"></i> Unified farm operations</li>
                    <li class="flex items-center gap-2"><i data-lucide="check" class="h-4 w-4"></i> Actionable alerts and tasks</li>
                    <li class="flex items-center gap-2"><i data-lucide="check" class="h-4 w-4"></i> Clear visibility for each zone</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="flex-1 p-8 lg:p-10">
        <div class="mx-auto max-w-md">
            <h2 class="text-2xl font-semibold text-slate-900">Sign in</h2>
            <p class="mt-2 text-sm text-slate-500">Access your dashboard and continue managing field operations.</p>

            <form asp-action="Login" method="post" class="mt-8 space-y-5">
                <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-600"></div>

                <div>
                    <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Email" class="form-control w-full" autocomplete="email" />
                    <span asp-validation-for="Email" class="mt-2 block text-sm text-rose-600"></span>
                </div>

                <div>
                    <label asp-for="Password" class="mb-2 block text-sm font-medium text-slate-700"></label>
                    <input asp-for="Password" class="form-control w-full" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="mt-2 block text-sm text-rose-600"></span>
                </div>

                <label class="flex items-center gap-3 text-sm text-slate-600">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <span>Keep me signed in</span>
                </label>

                <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-600 px-4 py-3 font-semibold text-white transition hover:bg-brand-700">Sign in</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
