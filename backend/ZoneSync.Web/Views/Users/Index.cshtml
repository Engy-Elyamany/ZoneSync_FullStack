@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Users";
}

<div class="page-content">
    <div class="panel-card">
        <div class="page-intro">
            <span class="eyebrow">Team</span>
            <h1 class="panel-title">Users</h1>
            <p class="panel-subtitle">A simple overview of the registered users in the workspace.</p>
        </div>

        <div class="table-shell mt-4">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Created</th>
                        <th>Last login</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserFirstName @user.UserLastName</td>
                            <td>@user.Email</td>
                            <td>@Convert.ToDateTime(user.CreatedAt).ToString("g")</td>
                            <td>@(user.LastLogin is null ? "Never" : Convert.ToDateTime(user.LastLogin).ToString("g"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
